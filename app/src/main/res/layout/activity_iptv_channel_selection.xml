<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101216"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/accent"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/iptv_category_filter"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/category_filter"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:focusable="true"
            android:nextFocusDown="@id/channel_list"
            android:popupBackground="#F21A2026"
            android:spinnerMode="dropdown" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:hint="@string/iptv_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Sol Dikey Araç Çubuğu -->
        <LinearLayout
            android:id="@+id/action_sidebar"
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_glass_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- 1. Tümünü Seç (Accent) -->
            <FrameLayout
                android:id="@+id/select_all_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/clear_button"
                android:nextFocusRight="@+id/channel_list"
                android:nextFocusUp="@id/category_filter">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/select_all_iptv_selection"
                    android:src="@drawable/ic_playlist_added"
                    app:tint="@color/accent" />
            </FrameLayout>

            <!-- 2. Seçimi Temizle (Kırmızı) -->
            <FrameLayout
                android:id="@+id/clear_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/category_button"
                android:nextFocusRight="@+id/channel_list"
                android:nextFocusUp="@+id/select_all_button">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/clear_visible_iptv_selection"
                    android:src="@drawable/ic_close"
                    app:tint="@color/remote_red" />
            </FrameLayout>

            <!-- 3. Kategori Filtresi (Sarı) -->
            <FrameLayout
                android:id="@+id/category_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/selected_filter_button"
                android:nextFocusRight="@+id/channel_list"
                android:nextFocusUp="@+id/clear_button">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/iptv_category_filter"
                    android:src="@drawable/ic_filter_list"
                    app:tint="@color/remote_yellow" />
            </FrameLayout>

            <!-- 4. Yalnızca Seçilenler (Mavi) -->
            <FrameLayout
                android:id="@+id/selected_filter_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/save_button"
                android:nextFocusRight="@+id/channel_list"
                android:nextFocusUp="@+id/category_button">

                <ImageView
                    android:id="@+id/selected_filter_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/selected_iptv_only"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/remote_blue" />
            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 5. Kaydet (Yeşil) -->
            <FrameLayout
                android:id="@+id/save_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusRight="@+id/channel_list"
                android:nextFocusUp="@+id/selected_filter_button">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/save_iptv_selection"
                    android:src="@drawable/ic_check"
                    app:tint="@color/remote_green" />
            </FrameLayout>
        </LinearLayout>

        <ListView
            android:id="@+id/channel_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="56"
            android:choiceMode="multipleChoice"
            android:divider="#3E4650"
            android:dividerHeight="1dp"
            android:listSelector="@drawable/bg_focusable"
            android:nextFocusLeft="@id/select_all_button"
            android:nextFocusRight="@id/save_button"
            android:nextFocusUp="@id/category_filter" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="16dp"
            android:background="#526579" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="44"
            android:background="@color/black">

            <androidx.media3.ui.PlayerView
                android:id="@+id/preview_player"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="false"
                android:keepScreenOn="true"
                app:resize_mode="fit"
                app:show_buffering="when_playing"
                app:use_controller="false" />

            <TextView
                android:id="@+id/preview_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/select_channel_for_preview"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#D916181C"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/preview_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/preview_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Alt Helper / Renkli Kumanda Efsanesi (Legend) Barı (Dokunmatik Tıklanabilir) -->
    <HorizontalScrollView
        android:id="@+id/helper_bar_scroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_panel"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/helper_bar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- 1. Kırmızı: Seçimi Temizle -->
            <LinearLayout
                android:id="@+id/action_btn_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/key_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/clear_visible_iptv_selection"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 2. Tümünü Seç (Accent) -->
            <LinearLayout
                android:id="@+id/action_btn_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_playlist_added"
                    app:tint="@color/accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/select_all_iptv_selection"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 3. Sarı: Kategori Filtresi -->
            <LinearLayout
                android:id="@+id/action_btn_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/key_yellow" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/iptv_category_filter"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 4. Mavi: Yalnızca Seçilenler -->
            <LinearLayout
                android:id="@+id/action_btn_selected_only"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/key_blue" />

                <TextView
                    android:id="@+id/selected_filter_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/selected_iptv_only"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 5. Yeşil: Kaydet -->
            <LinearLayout
                android:id="@+id/action_btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/key_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/save_iptv_selection"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <!-- Sağ Taraf: Kumanda Gezinme İpucu -->
            <TextView
                android:id="@+id/helper_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/iptv_selection_ok_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
