<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginVertical="2dp"
    android:background="@drawable/bg_channel"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
        android:paddingHorizontal="10dp">

    <ImageView
        android:id="@+id/channel_logo"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_tv" />

    <TextView
        android:id="@+id/channel_number"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="8dp"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/channel_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tech_badge"
                android:paddingHorizontal="3dp"
                android:textColor="@color/text_primary"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/channel_type_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/channel_type" />

            <ImageView
                android:id="@+id/channel_encrypted_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/encrypted_channel"
                android:src="@drawable/ic_lock"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/channel_hidden_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/hidden_channel"
                android:src="@drawable/ic_eye_off"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/channel_favorite_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/favorite_channel"
                android:src="@drawable/ic_star"
                android:visibility="gone" />

            <TextView
                android:id="@+id/source_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:textColor="@color/text_primary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/channel_program"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/program_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressBackgroundTint="#52606B"
            android:progressTint="@color/accent" />
    </LinearLayout>
</LinearLayout>
