<?xml version="1.0" encoding="utf-8"?>
<!-- 16:9 VOD card: poster area with bottom scrim + title, optional thin resume progress bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vod_card_root"
    android:layout_width="218dp"
    android:layout_height="wrap_content"
    android:layout_margin="7dp"
    android:background="@drawable/bg_vod_card"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="124dp">

            <ImageView
                android:id="@+id/vod_card_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_vod_scrim" />

            <TextView
                android:id="@+id/vod_card_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="9dp"
                android:paddingBottom="6dp"
                android:shadowColor="#B3000000"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vod_card_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="7dp"
                android:background="@drawable/bg_vod_pill_active"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/vod_card_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Thin resume progress: track + fill, width set in code. -->
        <LinearLayout
            android:id="@+id/vod_card_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginHorizontal="9dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bg_vod_progress_track"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:id="@+id/vod_card_progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_vod_progress_fill" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
