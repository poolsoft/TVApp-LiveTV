<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/guide_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20D1217"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <!-- Üst Başlık ve Tarih Çubuğu -->
        <LinearLayout
            android:id="@+id/guide_header"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/program_guide"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guide_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_guide_source_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guide_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Üst Program Detay Kartı (Tivimate / TV standardı göz hizası kartı) -->
        <LinearLayout
            android:id="@+id/guide_detail_card"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_guide_detail_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <!-- Kanal Bilgisi (Sol) -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/selected_channel_logo"
                    android:layout_width="52dp"
                    android:layout_height="38dp"
                    android:background="#0D1318"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tv" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/selected_channel_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/selected_channel_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="14dp"
                android:background="#263E52" />

            <!-- Program Bilgisi ve Açıklaması (Sağ) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detail_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detail_badge_live"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_guide_live_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="@string/live_badge"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/detail_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.1"
                    android:maxLines="2"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Zaman Cetveli (Timeline Ruler) Başlığı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="@string/channels"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#263E52" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#1F000000">

                <LinearLayout
                    android:id="@+id/timeline_ruler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <TextView android:id="@+id/timeline_time_0" style="@style/GuideTimelineTime" />
                    <TextView android:id="@+id/timeline_time_1" style="@style/GuideTimelineTime" />
                    <TextView android:id="@+id/timeline_time_2" style="@style/GuideTimelineTime" />
                    <TextView android:id="@+id/timeline_time_3" style="@style/GuideTimelineTime" />
                </LinearLayout>

                <View
                    android:id="@+id/current_time_header_line"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/accent"
                    android:elevation="6dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#263E52" />

        <!-- Ana Liste (RecyclerView) ve Canli Zaman Cizgisi -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/program_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:overScrollMode="never"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/empty_programs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="24dp"
                android:text="@string/no_epg_data"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Zaman Cizgisi Hizalama Katmani (Sol 240dp + 1dp ayractan sonra baslar) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <View
                    android:layout_width="240dp"
                    android:layout_height="match_parent" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/timeline_grid_track"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:id="@+id/current_time_grid_line"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@color/accent"
                        android:elevation="6dp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Alt Kumanda Kısayolları Çubuğu -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#263E52" />

        <LinearLayout
            android:id="@+id/guide_footer"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/guide_control_hints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/guide_control_hints"
                android:textColor="#7A8B9C"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
