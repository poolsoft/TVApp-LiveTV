<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/guide_overlay"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_guide_overlay"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/guide_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/program_guide"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guide_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/guide_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="15sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#263E52" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="38"
                android:gravity="bottom"
                android:paddingHorizontal="20dp"
                android:paddingBottom="12dp"
                android:text="@string/channels"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#263E52" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/selected_channel_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/selected_channel_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="#26000000">

                    <LinearLayout
                        android:id="@+id/timeline_ruler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp">

                        <TextView android:id="@+id/timeline_time_0" style="@style/GuideTimelineTime" />
                        <TextView android:id="@+id/timeline_time_1" style="@style/GuideTimelineTime" />
                        <TextView android:id="@+id/timeline_time_2" style="@style/GuideTimelineTime" />
                        <TextView android:id="@+id/timeline_time_3" style="@style/GuideTimelineTime" />
                    </LinearLayout>

                    <View
                        android:id="@+id/current_time_header_line"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@color/accent"
                        android:elevation="6dp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/guide_channel_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="38"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/guide_channel_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="true"
                    android:overScrollMode="never"
                    android:paddingBottom="10dp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#263E52" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:background="#14000000">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/program_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="true"
                    android:overScrollMode="never"
                    android:paddingBottom="10dp" />

                <TextView
                    android:id="@+id/empty_programs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="24dp"
                    android:text="@string/no_epg_data"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/current_time_grid_line"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/accent"
                    android:elevation="6dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/program_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E915181C"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="11dp">

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <ScrollView
                android:id="@+id/detail_description_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_guide_detail_scroll"
                android:fadeScrollbars="false"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </ScrollView>

            <TextView
                android:id="@+id/guide_control_hints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:text="@string/guide_control_hints"
                android:textColor="#7A8B9C"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
