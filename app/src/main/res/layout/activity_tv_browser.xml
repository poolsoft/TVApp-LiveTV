<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/browser_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161B22"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- TV'ye Don / Geri Butonu -->
        <Button
            android:id="@+id/btn_browser_back_to_tv"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:background="@drawable/bg_vod_secondary_btn"
            android:drawableStart="@drawable/ic_tv"
            android:drawablePadding="8dp"
            android:text="@string/browser_back_to_tv"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="16dp" />

        <!-- Geri (History Back) -->
        <ImageButton
            android:id="@+id/btn_browser_nav_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_vod_secondary_btn"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_primary"
            android:contentDescription="@string/browser_back_to_tv"
            android:focusable="true" />

        <!-- Yenile -->
        <ImageButton
            android:id="@+id/btn_browser_reload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_vod_secondary_btn"
            android:src="@drawable/ic_replay_10"
            android:tint="@color/text_primary"
            android:contentDescription="@string/browser_reload"
            android:focusable="true" />

        <!-- Adres ve Arama Cubugu -->
        <EditText
            android:id="@+id/edit_browser_url"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_browser_field"
            android:hint="@string/browser_url_hint"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true" />

        <!-- Git Butonu -->
        <Button
            android:id="@+id/btn_browser_go"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:background="@drawable/bg_vod_accent_btn"
            android:text="@string/browser_go"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <!-- Tespit Edilen Videoyu Oynat Cipi / Butonu -->
        <Button
            android:id="@+id/btn_play_stream"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_browser_chip_play"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="6dp"
            android:text="@string/browser_play_stream"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Sayfa Yuklenme Cizgisi -->
    <ProgressBar
        android:id="@+id/browser_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- CursorLayout ve WebView Govdesi -->
    <com.tvapp.livetv.browser.CursorLayout
        android:id="@+id/browser_cursor_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/browser_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Ekran Altinda Yuzen Buyuk Oynat Rozeti (CursorLayout hit-test ile tiklanabilir) -->
        <TextView
            android:id="@+id/browser_floating_play_chip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_browser_chip_play"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="8dp"
            android:text="@string/browser_play_stream"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </com.tvapp.livetv.browser.CursorLayout>

</LinearLayout>
