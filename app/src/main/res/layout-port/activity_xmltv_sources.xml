<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101216"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Üst Başlık ve Kapat Butonu Satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/xmltv_sources_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/xmltv_btn_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_focusable"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Kaynak Ekleme Butonları (İkili Yatay) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/add_url"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:text="@string/xmltv_from_url"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/add_file"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:text="@string/xmltv_from_file"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Eşleme Editörü Butonu -->
    <Button
        android:id="@+id/open_matches"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_focusable"
        android:text="@string/xmltv_match_editor"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <!-- Durum Mesajı -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/accent"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#3E4650" />

    <!-- Kayıtlı Kaynaklar Başlığı -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/xmltv_saved_sources"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Kaynak Listesi (Dikey Esnek) -->
    <ListView
        android:id="@+id/source_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="#3E4650"
        android:dividerHeight="1dp"
        android:listSelector="@drawable/bg_focusable" />

    <!-- Bilgilendirme Metni -->
    <TextView
        android:id="@+id/xmltv_source_remote_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/xmltv_source_remote_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Eski Kapat Butonu (Kod içi ID uyumluluğu için gizli tutuluyor) -->
    <Button
        android:id="@+id/close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_focusable"
        android:text="@string/close"
        android:textColor="@color/text_primary"
        android:visibility="gone" />

</LinearLayout>
