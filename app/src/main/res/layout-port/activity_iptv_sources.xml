<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101216"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Üst Başlık ve Kapat Butonu Satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/iptv_sources_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iptv_btn_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_focusable"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Kaynak Ekleme Butonları (Grid / Çiftli Yatay) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/import_url_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:drawableStart="@drawable/ic_link"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:text="@string/import_iptv_url"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/import_file_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:drawableStart="@drawable/ic_file"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:text="@string/import_iptv_file"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/import_xtream_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:drawableStart="@drawable/ic_server"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:text="@string/add_xtream_source"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/import_stalker_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:drawableStart="@drawable/ic_portal"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:text="@string/add_stalker_source"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Durum ve İlerleme -->
    <TextView
        android:id="@+id/import_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/accent"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/import_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#3E4650" />

    <!-- Kayıtlı Kaynaklar Başlığı ve Listesi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/saved_iptv_sources"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/source_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="#3E4650"
        android:dividerHeight="1dp"
        android:listSelector="@drawable/bg_focusable" />

</LinearLayout>
