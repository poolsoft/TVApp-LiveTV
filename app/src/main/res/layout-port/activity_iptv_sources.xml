<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101216"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Üst Başlık ve Kapat Butonu Satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/iptv_sources_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iptv_btn_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_focusable"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Kaynak Ekleme Butonları (Grid / Çiftli Yatay) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/import_url_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:drawableStart="@drawable/ic_link"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:text="@string/import_iptv_url"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/import_file_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:drawableStart="@drawable/ic_file"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:text="@string/import_iptv_file"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/import_xtream_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:drawableStart="@drawable/ic_server"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:text="@string/add_xtream_source"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/import_stalker_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:drawableStart="@drawable/ic_portal"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:text="@string/add_stalker_source"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/import_github_manifest_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_focusable"
        android:drawableStart="@drawable/ic_link"
        android:drawablePadding="8dp"
        android:drawableTint="@color/accent"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/import_github_manifest"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/bulk_refresh_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_focusable"
        android:drawableStart="@drawable/ic_scan"
        android:drawablePadding="8dp"
        android:drawableTint="@color/accent"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/bulk_refresh_sources"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/web_manage_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_focusable"
        android:drawableStart="@drawable/ic_server"
        android:drawablePadding="8dp"
        android:drawableTint="@color/accent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/web_manage"
        android:textColor="@color/text_primary" />

    <!-- Durum ve İlerleme -->
    <TextView
        android:id="@+id/import_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/accent"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/import_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#3E4650" />

    <!-- Kayıtlı Kaynaklar Başlığı ve Listesi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/saved_iptv_sources"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/source_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#3E4650"
            android:dividerHeight="1dp"
            android:listSelector="@drawable/bg_focusable"
            android:defaultFocusHighlightEnabled="false" />

        <!-- UI-003: liste gerçekten boşken iki dilli yönlendirme kartı.
             Eylem düğmesi yok: ekleme bu ekranın panel düğmeleriyle yapılıyor. -->
        <LinearLayout
            android:id="@+id/source_list_empty_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/source_list_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/web_empty"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/source_list_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/iptv_sources_empty_hint"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- UI-016: alt ipucu satırı. Metin kasıtlı olarak boş: kod ilk yüklemeden sonra
         girdi profiline göre dolduruyor (d-pad yoksa "OK: ..." komutu yerine dokunma
         jesti anlatılıyor). Yükleme sürerken yanlış bir komut göstermemek için
         layout'ta varsayılan metin yok. -->
    <TextView
        android:id="@+id/source_list_hint_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</LinearLayout>
