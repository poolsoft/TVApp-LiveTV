<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV oynatma kontrol satiri varsayilan durumu. Kod tarafi aktif secim imleci icin
     bg_iptv_control_selected kullanir (MainActivity.renderIptvControlSelection).
     state_focused dali yalniz sistem odak aramasini (cerceve/fare/dokunma) görünür
     klar; tema defaultFocusHighlightEnabled = false oldugundan aksi halde odak
     belirsiz kalirdi. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#DD202A32" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</selector>
