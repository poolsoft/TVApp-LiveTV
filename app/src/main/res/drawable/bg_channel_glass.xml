<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#E0496368" /><stroke android:width="2dp" android:color="#FFF0FFFF" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#8053747A" /><stroke android:width="1dp" android:color="#887FA8AC" /><corners android:radius="6dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#0DFFFFFF" /><stroke android:width="1dp" android:color="#16FFFFFF" /><corners android:radius="6dp" /></shape>
    </item>
</selector>
