<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape>
            <solid android:color="#6633B5E5" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#4033B5E5" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#E02A3944" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0011181E" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</selector>
