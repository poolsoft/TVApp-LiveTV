<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@android:color/transparent"/><corners android:radius="6dp"/></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent"/><stroke android:width="2dp" android:color="@color/dialog_text_primary"/><corners android:radius="6dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/accent"/><stroke android:width="2dp" android:color="@color/dialog_text_primary"/><corners android:radius="6dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent"/><corners android:radius="6dp"/></shape>
    </item>
</selector>
