<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#DD202A32"/><stroke android:width="2dp" android:color="@color/accent"/><corners android:radius="6dp"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="@color/selected"/><stroke android:width="1dp" android:color="@color/accent"/><corners android:radius="6dp"/></shape></item>
    <item><shape><solid android:color="@color/control"/><corners android:radius="6dp"/></shape></item>
</selector>
