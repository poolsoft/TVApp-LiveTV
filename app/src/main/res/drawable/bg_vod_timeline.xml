<?xml version="1.0" encoding="utf-8"?>
<!-- VOD zaman cizgisi satirinin secili olmayan durusu. Onceki surumde background = null
     idi ve sistem odağı bu satira dustugunde hicbir gosterge cikmiyordu.
     Secili durum icin bg_vod_timeline_selected kullanilmaya devam eder. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
