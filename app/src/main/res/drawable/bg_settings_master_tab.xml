<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape>
            <solid android:color="#FF33B5E5" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#2E33B5E5" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#E0203040" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0DFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
