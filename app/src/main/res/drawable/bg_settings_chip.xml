<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape>
            <solid android:color="#FF33B5E5" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#E60288D1" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#D0203040" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1A2530" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
