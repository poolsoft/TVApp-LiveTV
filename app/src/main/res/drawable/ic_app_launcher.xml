<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Modern Koyu Gradyan Zemin (Tüm TV launcher arkaplanlarında belirgin kontrast) -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <gradient
                android:angle="135"
                android:startColor="#1E293B"
                android:centerColor="#0F172A"
                android:endColor="#020617"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2.5dp"
                android:color="#00E5FF" />
        </shape>
    </item>

    <!-- Klasik TV İkonu - Renklendirilmiş & Katmanlı -->
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <vector
            android:width="64dp"
            android:height="64dp"
            android:viewportWidth="24"
            android:viewportHeight="24">

            <!-- TV Ekran İçi Dolgusu (Canlı Okyanus Mavisi) -->
            <path
                android:fillColor="#0284C7"
                android:pathData="M3,8 h18 v12 H3 z" />

            <!-- Ekran İçi Işıltı / Canlı Oynat İkonu -->
            <path
                android:fillColor="#00E5FF"
                android:pathData="M10,10.5 L16,14 L10,17.5 Z" />

            <!-- Canlı Neon Antenler -->
            <path
                android:fillColor="#00E5FF"
                android:pathData="M13.41,6 l3.29,-3.29 L16,2 l-4,4 -4,-4 -0.71,0.71 L10.59,6 Z" />

            <!-- Klasik TV Dış Kasası ve Ekran Çerçevesi (Beyaz/Açık Gri) -->
            <path
                android:fillColor="#F8FAFC"
                android:pathData="M21,6 h-7.59 l3.29,-3.29 L16,2 l-4,4 -4,-4 -0.71,0.71 L10.59,6 H3 c-1.1,0 -2,0.89 -2,2 v12 c0,1.1 0.9,2 2,2 h18 c1.1,0 2,-0.9 2,-2 V8 c0,-1.11 -0.9,-2 -2,-2 z m0,14 H3 V8 h18 v12 z" />
        </vector>
    </item>
</layer-list>
