<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101216"
    android:orientation="vertical">

    <!-- Video Oynatıcı Alanı -->
    <FrameLayout
        android:id="@+id/mobile_video_container"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="#000000">

        <!-- ExoPlayer / IjkPlayer PlayerView -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/mobile_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- Yükleniyor / Buffering Çarkı -->
        <ProgressBar
            android:id="@+id/mobile_buffering"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <!-- Dokunmatik ve Jest Yakalama Katmanı -->
        <View
            android:id="@+id/mobile_touch_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false" />

        <!-- Oynatıcı Kontrolleri Katmanı (Overlay) -->
        <FrameLayout
            android:id="@+id/mobile_controls_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="visible">

            <!-- Üst Kontrol Çubuğu -->
            <LinearLayout
                android:id="@+id/overlay_top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/overlay_btn_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/overlay_channel_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlay_channel_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/accent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/overlay_btn_channels"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/choose_channel_source"
                    android:padding="6dp"
                    android:src="@drawable/ic_list" />

                <ImageView
                    android:id="@+id/overlay_btn_aspect"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_aspect_ratio" />

                <ImageView
                    android:id="@+id/overlay_btn_tracks"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_audio" />

                <ImageView
                    android:id="@+id/overlay_btn_settings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_title"
                    android:padding="6dp"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <!-- Orta Kontroller (Play/Pause & Seek) -->
            <LinearLayout
                android:id="@+id/overlay_center_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/overlay_btn_rewind"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_mobile_overlay_control"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_replay_10"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/overlay_btn_play_pause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_mobile_overlay_control"
                    android:contentDescription="@null"
                    android:padding="14dp"
                    android:src="@drawable/ic_pause" />

                <ImageView
                    android:id="@+id/overlay_btn_forward"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_mobile_overlay_control"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_forward_10"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Alt Kontrol Çubuğu -->
            <LinearLayout
                android:id="@+id/overlay_bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <!-- Canlı Yayın Rozeti -->
                <TextView
                    android:id="@+id/overlay_live_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:drawableStart="@drawable/ic_live"
                    android:drawablePadding="4dp"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="@string/iptv_action_live"
                    android:textColor="#FF4444"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- VOD Süre & SeekBar Paneli -->
                <LinearLayout
                    android:id="@+id/overlay_vod_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/overlay_time_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:text="00:00" />

                    <SeekBar
                        android:id="@+id/overlay_seek_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:maxHeight="4dp"
                        android:minHeight="4dp"
                        android:progressTint="#2196F3"
                        android:thumbTint="#2196F3" />

                    <TextView
                        android:id="@+id/overlay_time_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp"
                        android:text="00:00" />
                </LinearLayout>

                <!-- Canlı yayında esnek boşluk -->
                <View
                    android:id="@+id/overlay_bottom_spacer"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/overlay_btn_fullscreen"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_fullscreen" />
            </LinearLayout>
        </FrameLayout>

        <!-- Ses & Parlaklık Jest Göstergesi (HUD) -->
        <LinearLayout
            android:id="@+id/mobile_gesture_hud"
            android:layout_width="140dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mobile_gesture_hud"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/hud_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_volume_up" />

            <TextView
                android:id="@+id/hud_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/hud_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressTint="@color/accent" />
        </LinearLayout>

        <!-- Tam Ekran Yan Kanal Çekmecesi (Side Channel Panel) -->
        <LinearLayout
            android:id="@+id/mobile_side_channel_drawer"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#E6101419"
            android:clickable="true"
            android:elevation="16dp"
            android:focusable="false"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <!-- Başlık ve Kapat Butonu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/choose_channel_source"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/side_drawer_btn_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <!-- Yan Panel Arama Çubuğu -->
            <EditText
                android:id="@+id/side_drawer_search_input"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_mobile_search_bar"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="6dp"
                android:hint="@string/search_short"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Yan Panel Kategori Çipleri -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/side_drawer_category_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Yan Panel Kanal Listesi -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/side_drawer_channel_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

    </FrameLayout>

    <!-- Dikey Mod İçerik Alanı (Kanal Listesi, Kategori ve Arama) -->
    <LinearLayout
        android:id="@+id/mobile_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#13151B"
        android:orientation="vertical">

        <!-- Üst Arama ve Yönetim Çubuğu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <EditText
                android:id="@+id/mobile_search_input"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mobile_search_bar"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="@string/search_short"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#6B7280"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/mobile_btn_sources"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_iptv_library" />

            <ImageView
                android:id="@+id/mobile_btn_channel_select"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_filter_list"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/mobile_btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_title"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Kategori Çipleri Listesi -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_category_recycler"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp" />

        <!-- Kanal Sayısı Bilgisi -->
        <TextView
            android:id="@+id/mobile_channel_count_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:textColor="#7A808C"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#20242E" />

        <!-- Ana Kanal Listesi -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_channel_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- Kanal Yok Boş Durum Görünümü -->
        <LinearLayout
            android:id="@+id/mobile_empty_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_iptv_library"
                app:tint="#6B7280" />

            <TextView
                android:id="@+id/mobile_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/no_channels_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mobile_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/iptv_only_empty_message"
                android:textColor="#9AA0A6"
                android:textSize="13sp" />

            <Button
                android:id="@+id/mobile_empty_action_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/accent"
                android:text="@string/manage_iptv_sources"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
